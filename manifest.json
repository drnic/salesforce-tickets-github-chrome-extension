{
  "manifest_version": 3,
  "name": "Salesforce Tickets GitHub PR Linker",
  "version": "1.0",
  "description": "Links Salesforce tickets to matching GitHub pull requests",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.lightning.force.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.lightning.force.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configure GitHub Token",
    "default_icon": {
      "16": "icons/salesforce-16.png",
      "32": "icons/salesforce-32.png",
      "48": "icons/salesforce-48.png",
      "128": "icons/salesforce-128.png"
    }
  },
  "icons": {
    "16": "icons/salesforce-16.png",
    "32": "icons/salesforce-32.png",
    "48": "icons/salesforce-48.png",
    "128": "icons/salesforce-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}